<?xml version="1.0" encoding="utf-8"?>
<!--
  Bloomlog은 의료 인접 PII(시술 이력·5축 진단·결제 기록)를 다루고,
  WebView localStorage에 Supabase 세션 리프레시 토큰이 저장된다.
  이 데이터가 구글 백업이나 기기간 전송으로 앱 밖에 나가면 안 되므로 전 도메인을 제외한다.

  allowBackup="false"만으로는 부족하다 — API 31+에서 그것은 클라우드 백업만 끄고,
  기기간 전송(device-transfer)은 이 파일이 있어야 차단된다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
